if(BUILD_TESTING)
    add_test(NAME agc_driver_refresh_unwatch_hash_no_import COMMAND agc_driver_refresh_unwatch_hash_tests)
    set_tests_properties(agc_driver_refresh_unwatch_hash_no_import PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_NO_HOST_IMPORT=1" SKIP_RETURN_CODE 77 TIMEOUT 60 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
    foreach(mode IN ITEMS present attachment_memo)
        string(REPLACE "_" "-" flag "${mode}")
        foreach(variant IN ITEMS scoped hold_site_breaks_off)
            set(test agc_driver_refresh_unwatch_hash_${mode}_${variant})
            add_test(NAME ${test} COMMAND agc_driver_refresh_unwatch_hash_tests --${flag})
            set_tests_properties(${test} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_NO_HOST_IMPORT=1" SKIP_RETURN_CODE 77 TIMEOUT 60 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
            if(variant STREQUAL "hold_site_breaks_off")
                set_property(TEST ${test} APPEND PROPERTY ENVIRONMENT "APS5_NO_HOLD_SITE_BREAKS=1")
            endif()
            if(WIN32)
                set_tests_properties(${test} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
            endif()
        endforeach()
    endforeach()
    if(WIN32)
        set_tests_properties(agc_driver_refresh_unwatch_hash_no_import PROPERTIES ENVIRONMENT_MODIFICATION
            "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()

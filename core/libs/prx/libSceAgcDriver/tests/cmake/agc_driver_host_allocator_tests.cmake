if(BUILD_TESTING)
    agc_add_draw_pipeline_test(agc_driver_draw_allocations)
    set_property(TEST agc_driver_draw_allocations agc_driver_draw_allocations_draw_pipeline agc_driver_draw_allocations_plan_verify APPEND PROPERTY ENVIRONMENT_MODIFICATION "VK_INSTANCE_LAYERS=unset:")
endif()

if(BUILD_TESTING)
    set(agcMeasureTests agc_driver_draw_allocations agc_driver_draw_allocations_draw_pipeline agc_driver_draw_allocations_plan_verify)
    set(agcMeasurePipeline "ANYPS5_NO_SHADER_CACHE=1;APS5_DRAW_PIPELINE=1;APS5_PIPELINED_DRAWS=32;APS5_PIPELINE_DISPATCH=1")
    foreach(agcRepeat 2 3)
        add_test(NAME agc_driver_draw_allocations_r${agcRepeat} COMMAND agc_driver_draw_allocations_tests)
        add_test(NAME agc_driver_draw_allocations_draw_pipeline_r${agcRepeat} COMMAND agc_driver_draw_allocations_tests)
        set_tests_properties(agc_driver_draw_allocations_draw_pipeline_r${agcRepeat} PROPERTIES ENVIRONMENT "${agcMeasurePipeline}")
        add_test(NAME agc_driver_draw_allocations_plan_verify_r${agcRepeat} COMMAND agc_driver_draw_allocations_tests)
        set_tests_properties(agc_driver_draw_allocations_plan_verify_r${agcRepeat} PROPERTIES ENVIRONMENT "${agcMeasurePipeline};APS5_VERIFY_DRAW_PLAN=1")
        list(APPEND agcMeasureTests agc_driver_draw_allocations_r${agcRepeat} agc_driver_draw_allocations_draw_pipeline_r${agcRepeat} agc_driver_draw_allocations_plan_verify_r${agcRepeat})
    endforeach()
    foreach(agcMeasureTest IN LISTS agcMeasureTests)
        set_property(TEST ${agcMeasureTest} APPEND PROPERTY ENVIRONMENT "APS5_DRAW_ALLOCATIONS_NO_LIMIT=1")
        set_property(TEST ${agcMeasureTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "VK_INSTANCE_LAYERS=unset:")
        set_tests_properties(${agcMeasureTest} PROPERTIES FAIL_REGULAR_EXPRESSION "the repeated draws and dispatches ran" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(WIN32)
            set_property(TEST ${agcMeasureTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()

if(BUILD_TESTING)
    agc_add_draw_pipeline_test(agc_driver_finisher_label_order)
    set(agcGateDrainedLabels "APS5_PIPELINE_DRAIN_LABELS=1")
    set(agcGateProfiled "APS5_PROFILE_DRAW=1")
    set(agcGateDumped "APS5_DUMP_DRAW_SHADERS=1")
    foreach(agcGateCase IN ITEMS DrainedLabels Profiled Dumped)
        string(TOLOWER "${agcGateCase}" agcGateName)
        set(agcGateTest agc_driver_finisher_label_order_${agcGateName})
        add_test(NAME ${agcGateTest} COMMAND agc_driver_finisher_label_order_tests)
        set_tests_properties(${agcGateTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_DRAW_PIPELINE=1;APS5_PIPELINED_DRAWS=32;APS5_PIPELINE_DISPATCH=1;${agcGate${agcGateCase}}" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(WIN32)
            set_tests_properties(${agcGateTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()

if(BUILD_TESTING)
    foreach(agcSpecializedFragmentsTest IN ITEMS agc_driver_specialized_fragment_identity agc_driver_color_logic_op agc_driver_color565_target agc_driver_color1555_target agc_driver_dual_source_blend agc_driver_eqaa_color_target agc_driver_array_layer_target agc_driver_emulated_color_compare agc_driver_fmask_image_reads agc_driver_image_gather_volume agc_driver_depth_plane_sampling)
        if(NOT TARGET ${agcSpecializedFragmentsTest}_tests)
            continue()
        endif()
        add_test(NAME ${agcSpecializedFragmentsTest}_specialized_fragments COMMAND ${agcSpecializedFragmentsTest}_tests)
        set_tests_properties(${agcSpecializedFragmentsTest}_specialized_fragments PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_SPECIALIZED_FRAGMENTS=1" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(WIN32)
            set_tests_properties(${agcSpecializedFragmentsTest}_specialized_fragments PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()

#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 2, std430) buffer Source { uint source[]; };
layout(set = 0, binding = 7, std430) buffer Target { uint target[]; };
layout(push_constant) uniform Slot { uint index; } slot;
void main() {
    for (uint word = 0u; word < 4u; ++word) target[slot.index * 4u + word] = source[word];
}

#version 450
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 64) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint words[]; };
layout(push_constant) uniform Parameters {
    Words target;
    Words source;
    Words baseline;
    Words flags;
    uint words;
    uint flag;
    uint phase;
    uint unused;
} parameters;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= parameters.words) return;
    if (parameters.phase == 0u) {
        if (parameters.target.words[index] != parameters.baseline.words[index]) atomicOr(parameters.flags.words[parameters.flag], 1u);
        return;
    }
    if (parameters.flags.words[parameters.flag] == 0u) parameters.target.words[index] = parameters.source.words[index];
}
